NODE_ENV=development
POSTGRES_PASSWORD=change-me-to-a-long-random-password
PORT=3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://preicfes_app:change-me@localhost:5432/preicfes
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
# Proxies inversos confiables delante de la API (0 si se expone directamente)
TRUST_PROXY=0
# Inicio de sesión con Google: ID de cliente OAuth tipo "Aplicación web" (Google Cloud Console).
# Vacío = deshabilitado. El origen del frontend debe estar en "Orígenes de JavaScript autorizados".
GOOGLE_CLIENT_ID=
# Solo para `npm test`: base desechable donde la prueba E2E puede escribir
# TEST_DATABASE_URL=postgresql://preicfes_app:change-me@localhost:55432/preicfes


# NEW CREDENTIALS FOR TESTING (DO NOT USE IN PRODUCTION)
NODE_ENV=test
# Puertos en el host (3000 y 5432 los usa otro proyecto en esta máquina)
API_PORT=3001
DB_PORT=5433
POSTGRES_PASSWORD=
PORT=3001
API_PREFIX=/api/v1
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
DB_POOL_MAX=10
TRUST_PROXY=0