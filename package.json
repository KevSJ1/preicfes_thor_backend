{
  "name": "preicfes-thor-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST para PreICFES Thor sobre PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "find src scripts test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test --test-concurrency=1 test/",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  }
}
